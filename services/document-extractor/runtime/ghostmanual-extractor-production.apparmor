abi <abi/4.0>,
include <tunables/global>

# Named service-only profile: no attachment, change_profile, or unconfined mode.
profile ghostmanual-extractor-production flags=(attach_disconnected,mediate_deleted,chroot_relative) {
  userns,
  capability setuid,
  capability setgid,
  # These are usable only inside a new user namespace: host CapBnd is SETUID/GID.
  capability sys_admin,
  capability net_admin,
  capability setpcap,
  capability sys_chroot,
  # Namespace-owner proc metadata access; host bounding set still excludes ptrace.
  capability sys_ptrace,
  network unix,
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network netlink raw,
  network netlink dgram,
  signal (send,receive) peer=ghostmanual-extractor-production,
  signal (receive) peer=unconfined,
  ptrace (read,readby) peer=ghostmanual-extractor-production,

  / r,
  /{usr,lib,lib64,opt,etc,service,fixtures,run,run/secrets,sys,sys/fs}/ r,
  /{,oldroot/}{usr,lib,lib64}/** mr,
  /{,oldroot/}opt/{tika,parser}/** mr,
  /{,oldroot/}etc/{java-17-openjdk,fonts}/** r,
  /{,oldroot/}etc/{ld.so.cache,passwd,group,nsswitch.conf,hosts,resolv.conf,localtime} r,
  /service/** r,
  /fixtures/** r,
  /run/secrets/server-key.pem r,
  /run/credentials/ r,
  /run/credentials/ghostmanual-extractor@*.service/ r,
  /run/credentials/ghostmanual-extractor@*.service/{client-ca,server-cert,server-key}.pem r,
  /etc/ssl/openssl.cnf r,
  /usr/bin/python3* ix,
  /usr/bin/bwrap ix,
  /usr/bin/tesseract ix,
  /usr/lib/jvm/java-17-openjdk-amd64/bin/java ix,
  /usr/lib/jvm/java-17-openjdk-amd64/lib/jspawnhelper ix,
  /tmp/ rw,
  /tmp/** rwk,
  /{newroot,oldroot}/ r,
  /newroot/** rw,
  /dev/ r,
  /dev/{null,zero,random,urandom,tty} rw,
  /proc/ r,
  /proc/** r,
  deny /proc/*/root/** rwklm,
  owner /proc/*/{uid_map,gid_map,setgroups} rw,
  # Pre-clone proc_fd loses /proc across namespaces; host PIDs have 1-7 digits.
  owner /[1-9]{,[0-9]}{,[0-9]}{,[0-9]}{,[0-9]}{,[0-9]}{,[0-9]}/{uid_map,gid_map,setgroups} rw,
  owner /[1-9]{,[0-9]}{,[0-9]}{,[0-9]}{,[0-9]}{,[0-9]}{,[0-9]}/{mountinfo,fd/} r,
  /sys/fs/cgroup/ r,
  /sys/fs/cgroup/* r,
  owner /sys/fs/cgroup/{cgroup.procs,cgroup.subtree_control} w,
  owner /sys/fs/cgroup/extractor/ rw,
  owner /sys/fs/cgroup/extractor/** rw,
  deny /sys/fs/cgroup/{memory.*,cpu.max,pids.max} w,

  # Bubblewrap 0.8 uses /tmp -> /newroot and two fixed pivot_root operations.
  mount fstype=tmpfs options=(rw,nosuid,nodev) -> /{tmp,newroot/tmp,newroot/dev}/,
  mount fstype=proc options=(rw,nosuid,nodev,noexec) -> /newroot/proc/,
  mount fstype=devpts options=(rw,nosuid,noexec) -> /newroot/dev/pts/,
  mount options=(rbind) -> /tmp/newroot/,
  mount options=(rbind) -> /newroot/{usr/,lib/,lib64/,opt/tika/,opt/parser/,etc/java-17-openjdk/,etc/fonts/,etc/ld.so.cache,proc/{sys/,sysrq-trigger,irq/,bus/},dev/{null,zero,full,random,urandom,tty}},
  # bind_mount preserves these inherited flags while adding RO/nosuid/nodev.
  mount options=(ro,nosuid,nodev,remount,bind,silent) options in (noexec,noatime,nodiratime,relatime) -> /newroot/{usr,lib,lib64,opt/tika,opt/parser,etc/java-17-openjdk,etc/fonts,proc/sys,proc/irq,proc/bus}/{,**},
  mount options=(ro,nosuid,nodev,remount,bind,silent) options in (noexec,noatime,nodiratime,relatime) -> /newroot/{etc/ld.so.cache,proc/sysrq-trigger},
  mount options=(nosuid,remount,bind,silent) options in (ro,nodev,noexec,noatime,nodiratime,relatime) -> /newroot/dev/{null,zero,full,random,urandom,tty},
  mount options=(rw,rslave,silent) -> /,
  mount options=(rw,rprivate,silent) -> /oldroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,
  umount /oldroot/,
  umount /,
}
