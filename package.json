{
  "name": "ghostmanual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "data:cleanup": "node --env-file-if-exists=.env scripts/cleanup.ts",
    "test:accessibility": "playwright test --config playwright.accessibility.config.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "ky": "2.1.0",
    "next": "16.4.1",
    "nodemailer": "10.1.4",
    "openai": "7.27.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
